---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang } from '../i18n/ui';
import scriptFont from '@fontsource/ms-madi/files/ms-madi-latin-400-normal.woff2?url';
import jostFont from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';

interface Props {
  lang: Lang; title: string; description: string;
  alt: { es: string; en: string };
  header?: 'overlay' | 'solid';
  schema?: Record<string, unknown>[];
}
const { lang, title, description, alt, header = 'overlay', schema = [] } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const hotel = {
  '@context': 'https://schema.org', '@type': 'Hotel', name: 'Casa Lumbre',
  address: { '@type': 'PostalAddress', streetAddress: 'Calle de la Lumbre 12', postalCode: '29008', addressLocality: 'Málaga', addressCountry: 'ES' },
  telephone: '+34 952 000 000', email: 'hola@casalumbre.es', numberOfRooms: 12, checkinTime: '15:00', checkoutTime: '11:00', url: new URL(alt.es, site).href,
};
---
<!doctype html>
<html lang={t.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alt.es, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.es, site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#3A3D2B" />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={scriptFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <script type="application/ld+json" set:html={JSON.stringify([hotel, ...schema])} />
  </head>
  <body data-header={header}>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} alt={alt} variant={header} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <slot name="after" />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
