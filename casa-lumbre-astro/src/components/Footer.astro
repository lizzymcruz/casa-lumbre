---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <p class="wordmark ft__wm">Casa Lumbre</p>
        <address>Calle de la Lumbre 12, 29008 Málaga<br /><a href="tel:+34952000000">+34 952 000 000</a> · <a href="mailto:hola@casalumbre.es">hola@casalumbre.es</a></address>
      </div>
      <div class="ft__cols">
        {t.footCols.map((c) => (
          <div><p class="label ft__h">{c.h}</p><ul>{c.items.map((i) => <li><a class="nav-text" href="#">{i}</a></li>)}</ul></div>
        ))}
        <form class="ft__news" onsubmit="event.preventDefault()">
          <label class="label ft__h" for="nl-email">{t.newsH}</label>
          <p>{t.newsBody}</p>
          <div class="ft__field">
            <input id="nl-email" type="email" placeholder={t.email} autocomplete="email" />
            <button class="nav-text" type="submit">{t.subscribe} ↗</button>
          </div>
        </form>
      </div>
    </div>
    <div class="ft__bot caption">
      <p>© 2026 Casa Lumbre · {t.demo}</p>
      <p>{t.legal.map((l, i) => <>{i > 0 && ' · '}<a href="#">{l}</a></>)}</p>
    </div>
  </div>
</footer>
<style>
  .ft { background: var(--bg-inverse); color: var(--text-inverse); padding: clamp(4rem, 8vw, 7rem) 0 calc(3rem + env(safe-area-inset-bottom)); }
  .ft a { text-decoration: none; }
  .ft__top { display: flex; justify-content: space-between; gap: 3rem 5rem; flex-wrap: wrap; }
  .ft__wm { font-size: clamp(4rem, 6vw, 5.5rem); margin-bottom: 1.25rem; }
  .ft address { font-style: normal; line-height: 1.7; }
  .ft__cols { display: flex; gap: 3rem 5rem; flex-wrap: wrap; }
  .ft__h { color: var(--text-inverse); opacity: .6; margin-bottom: 1rem; display: block; }
  .ft ul { display: grid; gap: .75rem; }
  .ft__news { max-width: 300px; display: grid; gap: .75rem; }
  .ft__field { display: flex; justify-content: space-between; border-bottom: 1px solid rgb(246 241 234 / .5); padding-bottom: .6rem; }
  .ft__field input { background: none; border: 0; color: inherit; font: 400 .875rem var(--f-sans); width: 100%; }
  .ft__field input::placeholder { color: inherit; opacity: .6; }
  .ft__field button { background: none; border: 0; color: inherit; cursor: pointer; font-weight: 500; }
  .ft__bot { color: var(--text-inverse); opacity: .65; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid rgb(246 241 234 / .2); margin-top: 5rem; padding-top: 1.5rem; }
  @media (max-width: 640px) { .ft__cols > div { min-width: 40%; } .ft__news { max-width: none; width: 100%; } .ft { padding-bottom: 6rem; } }
</style>
