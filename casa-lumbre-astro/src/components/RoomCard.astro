---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { routes, ui, type Lang } from '../i18n/ui';
import type { Room } from '../data/rooms';
interface Props { room: Room; lang: Lang; ratio?: string }
const { room, lang, ratio = '4 / 5' } = Astro.props;
const href = routes[lang].room(room.slug[lang]);
---
<article class="rc">
  <a href={href} class="rc__img curtain" style={`aspect-ratio:${ratio}`} tabindex="-1" aria-hidden="true">
    <Image src={room.image} alt="" widths={[400, 600, 900]} sizes="(max-width: 640px) 80vw, 33vw" />
  </a>
  <p class="caption">{room.meta[lang]}</p>
  <h3 class="h3"><a href={href}>{room.name[lang]}</a></h3>
  <p class="rc__desc">{room.short[lang]}</p>
  <Button href={href} variant="link">{ui[lang].discoverRoom}</Button>
</article>
<style>
  .rc { display: grid; gap: 1rem; align-content: start; }
  .rc__img { display: block; overflow: hidden; background: var(--bg-panel); margin-bottom: .25rem; }
  .rc__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .rc:hover .rc__img img { transform: scale(1.04); }
  .rc h3 a { text-decoration: none; }
  .rc__desc { max-width: 36ch; }
  .rc :global(.btn) { justify-self: start; }
</style>
