---
import { ui, routes, type Lang } from '../i18n/ui';
import { paths } from '../lib/site';
import WordmarkSvg from './WordmarkSvg.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const P = paths[lang];
const home = routes[lang].home;
const colLinks = [
  [P.rooms, `${home}#house`, `${home}#experiences`, `${home}#experiences`],
  [`${home}#location`, 'https://maps.google.com/?q=Catedral+de+M%C3%A1laga', P.book, P.accessibility],
];
const legalLinks = [P.legal, P.privacy, `${P.privacy}#cookies`, P.accessibility];
const ARROW = '<svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>';
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <p class="ft__wm"><WordmarkSvg /></p>
        <address>Calle de la Lumbre 12, 29008 Málaga<br /><a href="tel:+34952000000">+34 952 000 000</a> · <a href="mailto:hola@casalumbre.es">hola@casalumbre.es</a></address>
      </div>
      <div class="ft__cols">
        {t.footCols.map((c, ci) => (
          <div><p class="label ft__h">{c.h}</p><ul>{c.items.map((i, ii) => <li><a class="nav-text" href={colLinks[ci][ii]}>{i}</a></li>)}</ul></div>
        ))}
        <form class="ft__news" data-demo-form>
          <label class="label ft__h" for="nl-email">{t.newsH}</label>
          <p>{t.newsBody}</p>
          <div class="ft__field">
            <input id="nl-email" type="email" placeholder={t.email} autocomplete="email" required aria-describedby="nl-msg" />
            <button class="nav-text" type="submit">{t.subscribe} <Fragment set:html={ARROW} /></button>
          </div>
          <p class="caption ft__msg" id="nl-msg" data-form-msg aria-live="polite"></p>
        </form>
      </div>
    </div>
    <div class="ft__bot caption">
      <p>© 2026 Casa Lumbre · {t.demo}</p>
      <p>{t.legal.map((l, i) => <>{i > 0 && ' · '}<a href={legalLinks[i]}>{l}</a></>)}</p>
    </div>
  </div>
</footer>
<style>
  .ft { background: var(--bg-inverse); color: var(--text-inverse); padding: clamp(4rem, 8vw, 7rem) 0 calc(3rem + env(safe-area-inset-bottom)); }
  .ft a { text-decoration: none; }
  .ft__top { display: flex; justify-content: space-between; gap: 3rem 5rem; flex-wrap: wrap; }
  .ft__wm { width: clamp(13rem, 20vw, 17rem); margin-bottom: 1.25rem; }
  .ft__wm :global(svg) { display: block; width: 100%; height: auto; }
  .ft address { font-style: normal; line-height: 1.7; }
  .ft__cols { display: flex; gap: 3rem 5rem; flex-wrap: wrap; }
  .ft__h { color: var(--text-inverse); opacity: .6; margin-bottom: 1rem; display: block; }
  .ft ul { display: grid; gap: .75rem; }
  .ft__news { max-width: 300px; display: grid; gap: .75rem; }
  .ft__field { display: flex; justify-content: space-between; border-bottom: 1px solid rgb(246 241 234 / .5); padding-bottom: .6rem; }
  .ft__field input { background: none; border: 0; color: inherit; font: 400 .875rem var(--f-sans); width: 100%; }
  .ft__field input::placeholder { color: inherit; opacity: .6; }
  .ft__field button { display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap; background: none; border: 0; color: inherit; cursor: pointer; font-weight: 500; }
  .ft__field button :global(svg) { transition: transform .3s var(--ease); }
  .ft__field button:hover :global(svg) { transform: translate(2px, -2px); }
  .ft__msg { color: var(--text-inverse); opacity: .8; min-height: 1.2em; }
  .ft__bot { color: var(--text-inverse); opacity: .65; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid rgb(246 241 234 / .2); margin-top: 5rem; padding-top: 1.5rem; }
  @media (max-width: 640px) { .ft__cols > div { min-width: 40%; } .ft__news { max-width: none; width: 100%; } .ft { padding-bottom: 6rem; } }
</style>
